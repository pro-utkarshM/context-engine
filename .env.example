# OpenAI API key for the OpenAI model-backed runner (`--runner openai`).
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the default model passed to the OpenAI runner.
OPENAI_MODEL=gpt-5

# Optional: override the OpenAI API base URL if needed.
OPENAI_BASE_URL=https://api.openai.com/v1

# MiniMax API key for the MiniMax model-backed runner (`--runner minimax`).
MINIMAX_API_KEY=your_minimax_api_key_here

# Optional: override the default MiniMax model. Default in code: MiniMax-M3.
MINIMAX_MODEL=MiniMax-M3

# Optional: override the MiniMax API base URL if needed.
MINIMAX_BASE_URL=https://api.minimax.io/v1